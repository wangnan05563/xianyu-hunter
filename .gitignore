# ============================================================
# XianyuHunter .gitignore
# 规则按类别分组，每段附说明
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.pytest_tmp/
.mypy_cache/
.ruff_cache/
*.egg-info/
.eggs/
dist/
build/
.coverage
.coverage_html/
coverage.xml
coverage*.json
frontend/coverage/
htmlcov/

# ---------- Node.js ----------
node_modules/
frontend/tsconfig.tsbuildinfo

# ---------- 构建缓存（build-exe.ps1 生成，避免重复下载依赖）----------
.venv-build/
.cache/

# ---------- 运行时数据（不纳入版本控制）----------
# SQLite 数据库
*.db
*.db-journal
*.db-wal
*.db-shm

# 浏览器用户数据（登录态/Cookie）
browser-data/
browser-data.bak/
browser-data.recovery-*/

# 应用运行时数据目录（仅保留 .gitkeep 占位）
data/
!data/.gitkeep

# 备份目录
backup/
config/backups/

# ---------- 敏感配置 ----------
.env
.env.local
# config.yaml 可能包含钉钉/Telegram 等明文凭据（作为 keyring fallback）
# 若已误提交，需执行 git rm --cached config/config.yaml 移除跟踪
config/config.yaml

# ---------- 日志 ----------
*.log
*.out
*.err
logs/
# 运行时日志文件（loguru SSE 流输出，根目录）
run.stdout.log
run.stdout.*.log
run.stderr.log
# Jenkins 构建日志
jenkins_build_*.log

# ---------- SonarQube 扫描缓存 ----------
.scannerwork/
sonar-scan.log
sonar-results/

# ---------- 截图与可视化产物 ----------
*.png
*.jpg
*.jpeg
*.gif
*_shots/
screenshots/
tests/screenshots/
tests/visual/
scripts/.screenshots/

# ---------- 临时文件 ----------
*.tmp
*.bak
*.orig
*~
trace/
_filelist.txt
_git_status.txt

# 误重定向产生的根目录垃圾文件（如 less/命令输出被重定向）
/0
/17_xianyu
/17_xianyufrontend
/17_xianyu.worktreesmu2
/_r.json
/.tmp_diff.txt
/.s3358_lines.txt
# PowerShell 哈希表/命令误重定向（含特殊字符文件名，可能含敏感信息）
/=\@\{*
/onar-scanner*

# 测试输出（根目录）
/test_result.txt
/test_debug_output.txt
/pytest*.txt
/test-results.txt

# ---------- 临时调试脚本（根目录以 _ 开头）----------
/_*.py
/_*.ps1
/_*.bat

# SonarQube 调试脚本（根目录）
/check-scan*.ps1
/diagnose-api.ps1
/run-scan.ps1
/query-*.ps1
# SonarQube 一次性 Python 调试脚本（根目录）
/fetch_issues.py
/filter_issues.py
/group_issues.py
/check_issue*.py
/query_*.py

# SonarQube 调试输出（根目录）
/all-issues.csv
/all-issues.json
/issues-by-file.json
/issues-by-file.txt
/issues-by-rule.json
/my_issues.json
/issues_summary.txt
/filter_output*.txt
/scan-output.txt
/sonar-scan-progress.log
# SonarQube 临时分析输出（按组件名命名的调试文件）
/ItemList_issues.*
/*_issues.txt
/*_issues.json

# ---------- 历史遗留临时测试文件（预防再次创建）----------
test_pw*.py
test_pw*.txt
_test_result.txt
config_resp.jsonclear

# ---------- 第五轮清理新增（2026-07-05）----------
# .tmp_ 前缀调试脚本（SonarQube 分析/拆分等临时工具）
/.tmp_*.ps1
/.tmp_*.py
/.tmp_*.bat

# 根目录临时测试脚本（test_*.py，正式测试应在 tests/ 目录）
/test_*.py

# 根目录临时运行脚本（run_*.py / run_*.js，正式脚本应在 scripts/）
/run_*.py
/run_*.js
/run_*.ps1

# 根目录 git 调试脚本与输出
/git_*.py
/git_*.txt

# 根目录 SonarQube Python 调试脚本（除已声明的 fetch_issues.py 等）
/check_sonar.py
/query_sonar.py
/diag*.py
/fetch_status3_tmp.py

# 根目录验证脚本与输出
/verify_*.py
/verify_*.txt

# 根目录 skill 集成 / git 提交调试产物
/commit_msg.txt
/compare_*.ps1
/compare_result.txt
/do_commit.js
/do_git_commit.ps1
/get_git_info.js
/git_status.txt
/git_commit_result.txt
/integrate_*.ps1
/diff_*.ps1
/diff_skills.ps1

# 根目录 diff / 调试输出 txt
/app_diff.txt
/app_old.txt
/diffs_review.txt
/pytest_n7.txt
/pytest_output.log
/tabbar_debug.txt
/tabbar_direct.txt
/test_result_output.txt
/tsc_output.txt
/vitest_out.txt
/vitest_result.txt

# 根目录调试日志（_ 前缀，含大量调试输出）
/_*.log
/_*.txt

# 异常文件名（PowerShell 误重定向含特殊字符）
/not enabled*
/ubprocess*

# ---------- 第六轮清理新增（2026-07-09）----------
# 一次性检查 PS1 脚本（check-*.ps1 模式，防止根目录再生成）
/check-*.ps1

# 临时 HTML 输出（前端页面快照/调试用）
/_temp_*.html

# 一次性 SonarQube Python 工具（按文件名特征扩展）
/check_s*.py
/list_*.py
/merge_sonar.py
/parse_sonar.py
/*_sonar.py

# 异常文件名前缀的 PS1（避免 PowerShell 误重定向）
# 兜底：所有 PS1 文件都应经过 pre-commit 检查是否在白名单

# ---------- 前端构建产物 ----------
src/xianyu_hunter/web/static/spa/

# ---------- 前端调试产物（frontend/ 根目录，非 src/）----------
# TypeScript 检查 / Vitest 运行调试脚本（正式配置在 tsconfig.json / vitest.config.ts）
/frontend/check_tsc.js
/frontend/run_tsc.js
/frontend/run-tsc.ps1
/frontend/tsc_check.js
/frontend/tsc_runner.js
/frontend/tsc_simple.js
/frontend/vitest_runner.js
# 前端调试日志与临时输出
/frontend/build.log
/frontend/test.log
/frontend/test2.log
/frontend/tsc.log
/frontend/vite_stderr.log
/frontend/vite_stdout.log
/frontend/run.stdout.log
/frontend/_ps_test.txt
/frontend/ws_test2.txt

# ---------- 截图与运行时用户数据 ----------
test-screenshots/
.uploads/

# ---------- 异常命名后缀的根目录产物（如 .txtcd 是错误输入）----------
# 这一类文件名后缀不规则，建议在终端命令前检查重定向目标，避免误生成
/*.txtcd

# ---------- IDE ----------
.idea/
.vscode/
.trae/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---------- 第七轮清理新增（2026-08-08）----------
# 根目录 PID 文件（SonarQube 扫描残留）
/scan.pid
# 根目录测试结果 XML（pytest 生成）
/pytest-results.xml
# PyInstaller 构建 spec（xianyu-hunter.spec 是手工维护的源码文件，必须随仓库提交）
# 历史误区：曾误标为"由构建脚本生成不应提交"并加入忽略，但 build-exe.ps1 从不生成该
#   spec，只调用 `pyinstaller xianyu-hunter.spec`，导致 spec 丢失后构建直接报
#   "Spec file not found"。因此改为纳入版本控制，避免再次静默丢失。
# xianyu-hunter.spec
# 根目录临时调试脚本（非 _ 前缀，但一次性使用）
/check_fix.py
# 根目录 VBS 脚本（应移至 scripts/）
/静默启动.vbs
# SonarQube 调试输出目录（临时诊断文件）
docs/04-系统维护/sonar-reports/diag*.json
docs/04-系统维护/sonar-reports/fetch_status*.py
docs/04-系统维护/sonar-reports/sonar-current-status.json
docs/04-系统维护/sonar-reports/test_ping.py
docs/04-系统维护/sonar-reports/test_write.txt
docs/04-系统维护/sonar-reports/pytest*.log
docs/04-系统维护/sonar-reports/sonar-status.log
docs/04-系统维护/sonar-reports/test_pwsh.txt

# ---------- Git Worktrees ----------
.worktrees/

# ---------- 第八轮清理新增（2026-08-11）----------
# 以下目录在本轮清理中已删除，加入忽略以防再次累积/误提交
test_results/
temp/
tmp/
