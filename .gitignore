# ============================================================
# XianyuHunter .gitignore
# 规则按类别分组，每段附说明
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.pytest_tmp/
.mypy_cache/
.ruff_cache/
*.egg-info/
.eggs/
dist/
build/
.coverage
.coverage_html/
coverage.xml
coverage*.json
htmlcov/

# ---------- Node.js ----------
node_modules/
frontend/tsconfig.tsbuildinfo

# ---------- 运行时数据（不纳入版本控制）----------
# SQLite 数据库
*.db
*.db-journal
*.db-wal
*.db-shm

# 浏览器用户数据（登录态/Cookie）
browser-data/
browser-data.bak/

# 应用运行时数据目录（仅保留 .gitkeep 占位）
data/
!data/.gitkeep

# 备份目录
backup/
config/backups/

# ---------- 敏感配置 ----------
.env
.env.local
# config.yaml 可能包含钉钉/Telegram 等明文凭据（作为 keyring fallback）
# 若已误提交，需执行 git rm --cached config/config.yaml 移除跟踪
config/config.yaml

# ---------- 日志 ----------
*.log
*.out
*.err
logs/
# 运行时日志文件（loguru SSE 流输出，根目录）
run.stdout.log
run.stdout.*.log
run.stderr.log
# Jenkins 构建日志
jenkins_build_*.log

# ---------- SonarQube 扫描缓存 ----------
.scannerwork/
sonar-scan.log
sonar-results/

# ---------- 截图与可视化产物 ----------
*.png
*.jpg
*.jpeg
*.gif
*_shots/
screenshots/
tests/screenshots/
tests/visual/
scripts/.screenshots/

# ---------- 临时文件 ----------
*.tmp
*.bak
*.orig
*~
trace/
_filelist.txt
_git_status.txt

# 误重定向产生的根目录垃圾文件（如 less/命令输出被重定向）
/0
/17_xianyu
/17_xianyufrontend
/_r.json
/.tmp_diff.txt
/.s3358_lines.txt

# 测试输出（根目录）
/test_result.txt
/test_debug_output.txt
/pytest_result.txt
/pytest_output.txt

# ---------- 临时调试脚本（根目录以 _ 开头）----------
/_*.py
/_*.ps1
/_*.bat

# SonarQube 调试脚本（根目录）
/check-scan*.ps1
/diagnose-api.ps1
/run-scan.ps1
/query-*.ps1

# ---------- 历史遗留临时测试文件（预防再次创建）----------
test_pw*.py
test_pw*.txt
_test_result.txt
config_resp.jsonclear

# ---------- 前端构建产物 ----------
src/xianyu_hunter/web/static/spa/

# ---------- 截图与运行时用户数据 ----------
test-screenshots/
.uploads/

# ---------- 异常命名后缀的根目录产物（如 .txtcd 是错误输入）----------
# 这一类文件名后缀不规则，建议在终端命令前检查重定向目标，避免误生成
/*.txtcd

# ---------- IDE ----------
.idea/
.vscode/
.trae/
*.swp
*.swo
.DS_Store
Thumbs.db
