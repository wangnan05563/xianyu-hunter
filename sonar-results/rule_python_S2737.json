                                             {
                                                 "key":  "root_cause",
                                                 "content":  "\u003cp\u003eAn \u003ccode\u003eexcept\u003c/code\u003e clause that only rethrows the caught exception has the same effect as omitting the \u003ccode\u003eexcept\u003c/code\u003e altogether and\nletting it bubble up automatically.\u003c/p\u003e\n\u003cpre\u003e\na = {}\ntry:\n    a[5]\nexcept KeyError:\n    raise  # Noncompliant\n\u003c/pre\u003e\n\u003cp\u003eSuch clauses should either be removed or populated with the appropriate logic.\u003c/p\u003e\n\u003cpre\u003e\na = {}\ntry:\n    a[5]\nexcept KeyError as e:\n    logging.exception(\u0027error while accessing the dict\u0027)\n    raise e\n\u003c/pre\u003e"
                                             }
                                         ],
