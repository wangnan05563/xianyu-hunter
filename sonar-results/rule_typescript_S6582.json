                 "name":  "Optional chaining should be preferred",
                 "createdAt":  "2026-03-11T22:20:45+0800",
                 "severity":  "MAJOR",
                 "status":  "READY",
                 "isTemplate":  false,
                 "tags":  [

                          ],
