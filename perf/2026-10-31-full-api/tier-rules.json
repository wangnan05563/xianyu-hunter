 "rules": [
  {
   "pattern": "^/api/maintenance/status",
   "method": "GET",
   "tier": "probe_single",
   "reason": "单请求耗时 >60s（客户端超时判 000），留在负载轮会把整轮 TPS 稀释成假瓶颈；改为单发计量并单列"
  },
  {
   "pattern": "^/api/tasks/\\{task_id\\}/links/refresh",
   "method": "POST",
   "tier": "blocked",
   "reason": "沙箱关闭调度器，采集器不可用，稳定返回 503，属环境口径而非容量缺陷"
  },
  {
   "pattern": "^/api/evaluations/batch-collect-official",
   "method": "POST",
   "tier": "blocked",
   "reason": "同上：采集器未运行返回 503；且真实触发会出网抓取"
  },
  {
   "pattern": "^/api/tasks/links/auto-migrate",
   "method": "POST",
   "tier": "probe_single",
   "reason": "全表迁移类批处理（基线 1.4s/次），重复执行会改数据，不进负载轮"
  },
  {
   "pattern": "/stream$",
   "method": "GET",
   "tier": "blocked",
   "reason": "SSE/长连接，请求级吞吐口径不适用"
  },
  {
   "pattern": "^/api/tunnel",
   "tier": "blocked",
   "reason": "启动内网穿透会对外暴露本机端口，属生产安全事故，压测期禁止"
  },
  {
   "pattern": "^/api/orders",
   "method": "GET",
   "tier": "load_read",
   "reason": "本地抢单记录查询"
  },
  {
   "pattern": "^/api/orders",
   "tier": "blocked",
   "reason": "抢单/确认下单会向闲鱼真实下单，任何环境均禁止自动化压测"
  },
  {
   "pattern": "^/api/ai(-deep)?$",
