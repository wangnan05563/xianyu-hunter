# 推送服务密钥（首次启动时填入，启动后自动迁移到 keyring 加密存储）
# 至少配置一个
SERVERCHAN_KEY=
PUSHPLUS_TOKEN=
BARK_SERVER=https://api.day.app
BARK_KEY=

# 可选：AI 服务（v1.0 启用）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
AI_ENABLED=True

# 可选：Embedding 服务（与 LLM 解耦）
# 三种模式：
# 1. 本地 Python 推理（推荐，无外部依赖）：
#    EMBEDDING_BASE_URL 留空，使用 sentence-transformers + bge-small-zh-v1.5
#    需安装：pip install torch --index-url https://download.pytorch.org/whl/cpu
#           pip install sentence-transformers
# 2. OpenAI 兼容远程服务（Ollama/OpenAI/智谱等）：
#    EMBEDDING_BASE_URL=http://localhost:11434/v1（Ollama）
#    EMBEDDING_API_KEY=ollama
#    EMBEDDING_MODEL=nomic-embed-text
#    EMBEDDING_DIMENSIONS=768
# 3. 复用 LLM 配置（OpenAI 等同时支持 LLM 和 embedding 的厂商）：
#    留空 EMBEDDING_BASE_URL + 留空 EMBEDDING_MODEL，后端 fallback 到 OPENAI_*
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 0 表示由模型决定；bge-small-zh-v1.5 = 512；OpenAI text-embedding-3-small = 1536
EMBEDDING_DIMENSIONS=512

# 日志级别：DEBUG / INFO / WARN / ERROR
LOG_LEVEL=INFO
